{
  "name": "tenveo-studio",
  "productName": "Tenveo Studio",
  "version": "1.6.0",
  "description": "Consola del switcher Tenveo PC500 y estudio de producción con escenas, desde la Mac",
  "author": "ThePunisherBaby",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "mock": "node scripts/mock-servers.mjs",
    "web": "node scripts/serve-web.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:video": "node scripts/smoke-video.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron dev/render-icon.mjs",
    "check-device": "node scripts/check-device.mjs",
    "prepare-adb": "node scripts/prepare-adb.mjs",
    "dist": "node scripts/prepare-adb.mjs && electron-builder --mac --universal",
    "dist:x64": "node scripts/prepare-adb.mjs && electron-builder --mac --x64",
    "dist:arm64": "node scripts/prepare-adb.mjs && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3",
    "node-media-server": "4.4.3"
  },
  "build": {
    "appId": "com.tenveo.studiolink",
    "productName": "Tenveo Studio",
    "artifactName": "TenveoStudio-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "src/preload/**/*",
      "src/core/**/*",
      "src/renderer/**/*",
      "!**/*.md"
    ],
    "electronLanguages": [
      "es",
      "en"
    ],
    "extraResources": [
      {
        "from": "vendor/platform-tools",
        "to": "platform-tools",
        "filter": [
          "adb",
          "NOTICE.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "x64ArchFiles": "**/platform-tools/adb",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Tenveo Studio controla el switcher Tenveo PC500 y recibe su video por la red local.",
        "NSCameraUsageDescription": "Tenveo Studio usa las cámaras y capturadoras de la Mac como fuentes de las escenas.",
        "NSCameraUseContinuityCameraDeviceType": true,
        "NSMicrophoneUsageDescription": "Tenveo Studio usa el audio de las cámaras y capturadoras en las transmisiones."
      }
    },
    "dmg": {
      "title": "Tenveo Studio"
    }
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
